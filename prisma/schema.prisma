generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PLANNED
  DONE
  MOVED
}

enum GoalStatus {
  ACTIVE
  DONE
  ARCHIVED
}

model User {
  id            String    @id
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  workStart     String?
  workEnd       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  tasks     Task[]
  plans     Plan[]
  goals     Goal[]
  habits    Habit[]
  reminders Reminder[]
  files     File[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  detail      String?
  timeLabel   String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PLANNED)
  dueDate     DateTime?
  durationMin Int?
  category    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  planItems   PlanItem[]
  reminders   Reminder[]
  files       File[]

  @@index([userId, status])
  @@index([userId, dueDate])
}

model Plan {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  summary   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     PlanItem[]

  @@unique([userId, date])
  @@index([userId, date])
}

model PlanItem {
  id        String @id @default(uuid())
  planId    String
  plan      Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sortOrder Int    @default(0)

  @@index([planId, sortOrder])
}

model Goal {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  target    String?
  progress  Int        @default(0)
  status    GoalStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
}

model Habit {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  frequency  String    @default("DAILY")
  streak     Int       @default(0)
  lastDoneAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model Reminder {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  remindAt  DateTime
  channel   String   @default("IN_APP")
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, remindAt])
}

model File {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  originalName String
  blobKey      String
  mime         String
  size         Int
  createdAt    DateTime @default(now())

  @@index([userId])
}

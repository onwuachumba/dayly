# Reproduce this project's known-good install behavior on CI hosts (e.g. Vercel).
# better-call@1.4.0 (Better Auth chain) declares an optional peer on zod@^4,
# while the app pins zod v3. Strict resolution fails (ERESOLVE); legacy
# resolution nests the optional copy, exactly as package-lock.json records.
legacy-peer-deps=true

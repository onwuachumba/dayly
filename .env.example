# Database connection.
# On Netlify hosting and under `netlify dev`, the connection comes from
# NETLIFY_DB_URL automatically (see lib/db.ts) — nothing to paste.
# For plain local runs (no `netlify dev`), set DATABASE_URL below.
# Prisma CLI commands (migrate diff/validate) use DIRECT_URL.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dayly?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.neon.tech/dayly?sslmode=require

# Better Auth (email + password). Generate a random 32+ character string.
# BETTER_AUTH_URL is the public app URL (http://localhost:3000 for local dev).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Netlify Blobs local dev only (on Netlify hosting this resolves automatically).
# Create a personal access token + site ID, or run inside `netlify dev`.
NETLIFY_SITE_ID=
NETLIFY_BLOBS_TOKEN=
